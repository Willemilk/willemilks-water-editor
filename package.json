{
  "name": "willemilks-water-editor",
  "private": true,
  "version": "1.8.2",
  "description": "A modern level editor for Where's My Water? with full terrain painting. Runs as a desktop app (Electron) or in the browser.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "keywords": [
    "wheres-my-water",
    "level-editor",
    "modding",
    "wmw",
    "electron"
  ],
  "author": "Willemilk",
  "license": "MIT",
  "dependencies": {
    "fflate": "^0.8.2",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.willemilk.watereditor",
    "productName": "Willemilks Water Editor",
    "copyright": "Copyright © 2026 Willemilk",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Willemilks Water Editor",
      "artifactName": "WillemilksWaterEditor-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "WillemilksWaterEditor-Portable-${version}.${ext}"
    }
  }
}
